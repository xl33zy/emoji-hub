# Required for /api/mood/{slug} and Mood Match. Without it the rest of the app still works.
GEMINI_API_KEY=

# Frontend origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:5173

# Defaults below match application.yaml — override only if you need to change them
EMOJIHUB_BASE_URL=https://emojihub.yurace.pro/api
EMOJIHUB_CONNECT_TIMEOUT=2s
EMOJIHUB_READ_TIMEOUT=8s
EMOJIHUB_CACHE_REFRESH_INTERVAL=PT50M

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CONNECT_TIMEOUT=3s
GEMINI_READ_TIMEOUT=15s

PORT=8080